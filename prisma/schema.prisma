enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CompanyApplicationStatus {
  DRAFT
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
}

enum OpportunityType {
  PURCHASE_REQUEST
  TENDER
  DISTRIBUTOR
  SUPPLIER
  PARTNERSHIP
  IMPORT
  EXPORT
  INVESTMENT
  SERVICE
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  phone                String?              @unique
  passwordHash         String
  fullName             String
  status               UserStatus           @default(ACTIVE)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  sessions             Session[]
  companiesOwned       Company[]            @relation("CompanyOwner")
  companyMembers       CompanyMember[]
  applications         CompanyApplication[]
  role                 UserRole             @default(USER)
  opportunitiesCreated Opportunity[]        @relation("OpportunityCreator")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id              String               @id @default(cuid())
  ownerId         String
  name            String
  slug            String               @unique
  description     String?
  logoUrl         String?
  coverUrl        String?
  catalogUrl      String?
  sector          String?
  city            String?
  website         String?
  contactEmail    String?
  contactPhone    String?
  establishedYear Int?
  employeeCount   Int?
  isVerified      Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  owner           User                 @relation("CompanyOwner", fields: [ownerId], references: [id])
  members         CompanyMember[]
  applications    CompanyApplication[]
  opportunities   Opportunity[]

  @@index([ownerId])
  @@index([sector])
  @@index([city])
}

model CompanyApplication {
  id            String                   @id @default(cuid())
  userId        String
  companyId     String?
  companyName   String
  legalName     String?
  taxNumber     String?
  commercialReg String?
  status        CompanyApplicationStatus @default(DRAFT)
  adminNotes    String?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       Company?                 @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([status])
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String
  userId    String
  role      CompanyMemberRole @default(EMPLOYEE)
  createdAt DateTime          @default(now())
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

model Opportunity {
  id          String            @id @default(cuid())
  creatorId   String
  companyId   String?
  title       String
  description String
  type        OpportunityType
  status      OpportunityStatus @default(PUBLISHED)
  sector      String?
  city        String?
  budgetMin   Decimal?          @db.Decimal(14, 2)
  budgetMax   Decimal?          @db.Decimal(14, 2)
  currency    String            @default("EGP")
  deadline    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  creator     User              @relation("OpportunityCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  company     Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([creatorId])
  @@index([companyId])
  @@index([type, status])
  @@index([createdAt])
}
